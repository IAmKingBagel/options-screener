# Template only — copy to `.env` and set your real values there.
#   copy .env.example .env
# The app loads `.env`, not this file. Never commit real API keys.
MASSIVE_API_KEY=your_api_key_here

# Backend
DATABASE_URL=sqlite:///./options_screener.db
API_HOST=0.0.0.0
API_PORT=8000
CHAIN_CACHE_TTL_SECONDS=300

# Frontend dev proxy target
VITE_API_BASE_URL=http://localhost:8000
